rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul toi peux lire et écrire. Remplace l'email par le tien (en minuscules).
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'visionstreaming01@gmail.com';
    }
  }
}
